SELECT a.adv_id, c.campaign_id, ac.entity_id, ac.other_id,p.pub_id, p.slot_id, v.size_id, v.creative_id
FROM adv_creative v
INNER JOIN adv_item i USING (item_id)
INNER JOIN adv_campaign c USING (campaign_id)
INNER JOIN adv      a USING (adv_id)
LEFT JOIN ac ON (ac.entitytype_id=4 AND ac.entity_id=a.adv_id AND ac.othertype_id=3)
LEFT JOIN ActivePubWeb      p ON (p.pub_id = ac.other_id)
WHERE a.active="Yes" AND c.active="Yes" AND i.active="Yes" AND v.active="Yes"
AND ( c.access_order ='Inherit' AND (a.access_order="Black" AND ac.entity_id IS NULL))
AND (i.startx <= NOW() OR (i.startx IS NULL))
AND (  i.endx >= NOW() OR (  i.endx IS NULL))
AND c.target_type = "Web"

SELECT a.adv_id, c.campaign_id, ac.entity_id, ac.other_id,p.pub_id, p.slot_id, v.size_id, v.creative_id
FROM adv_creative v
INNER JOIN adv_item i USING (item_id)
INNER JOIN adv_campaign c USING (campaign_id)
INNER JOIN adv      a USING (adv_id)
LEFT JOIN ac ON (ac.entitytype_id=4 AND ac.entity_id=a.adv_id AND ac.othertype_id=3 AND ac.other_id=4)
LEFT JOIN ActivePubWeb      p ON (p.pub_id = ac.other_id)
WHERE a.active="Yes" AND c.active="Yes" AND i.active="Yes" AND v.active="Yes"
AND (i.startx <= NOW() OR (i.startx IS NULL))
AND (  i.endx >= NOW() OR (  i.endx IS NULL))
AND c.target_type = "Web"

