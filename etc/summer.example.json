                "db": {
                    "Default": true,
                    "Credential": ["login", "passwd", "direct", "ganalyst"],
                    "Sql": "SELECT analyst_id, login AS analyst_login, passwd FROM analyst WHERE login=? AND active='Yes'",
                    "Password_hash": "passwd",
		    "Legacy_password_upgrade": true,
                    "OutPars": ["analyst_id", "analyst_login", "passwd"]
                }
            }
        }
    }
