            "Issuers": {
                "db": {
		"Default": true,
                    "Credential": [ "login", "passwd", "direct", "gadmin" ],
                    "Sql": "SELECT admin_id, login AS admin_login, passwd FROM admin WHERE login=? AND active='Yes'",
                    "Password_hash": "passwd",
		    "Legacy_password_upgrade": true,
                    "OutPars": [ "admin_id", "admin_login", "passwd" ]
                }
            }
        },
        "analyst": {
            "Id_name": "analyst_id",
            "Type_id": 1,
            "Attributes": ["analyst_id", "analyst_login"],
            "Secret": "replace-analyst-secret",
            "Coding": "replace-analyst-coding",
            "Surface": "ganalyst",
            "Duration": 43200,
            "MaxAge": 43200,
            "Logout": "/",
            "Permissions": ["account.security.*", "report.marketplace.read", "report.advertiser.read", "report.publisher.read", "experiment.read", "quality.evidence.read"],
