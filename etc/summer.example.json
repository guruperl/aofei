{
    "ProjectRoot" : "../pzdesign",
    "Script"       : "/goto",
    "ServerURL"   : "http://localhost:8080",
    "CORSOrigins" : [],
    "ServerPort"  : "8080",
    "DocumentRoot": "../pzdesign/www",
    "UploadURL"   : "http://localhost:8080/uploads",
    "UploadDir"   : ".local/uploads",
    "Template"     : "../pzdesign/tmpls",
    "ConnectArray": ["mysql","aofei:aofei_pass@tcp(127.0.0.1:3307)/aofei?parseTime=true"],
    "Pubrole": "web",
    "Secret": "replace-summer-secret",
    "Identity": {
        "Enabled": false,
        "KeyEnv": "GENELET_IDENTITY_KEY",
        "Issuer": "W8M",
        "SessionAbsoluteSeconds": 43200,
        "SessionIdleSeconds": 1800,
        "ReauthSeconds": 600,
        "RecoveryTTLSeconds": 900,
        "TOTPWindow": 1,
        "RecoveryCodeCount": 10,
        "RequiredTOTP": ["admin", "adv", "pub", "agent", "analyst"],
        "AuditRetentionDays": 400
    },
    "Chartags": {
        "e": {
            "ContentType": "text/html; charset='UTF-8'",
            "Short": "html"
        },
        "g": {
            "ContentType": "text/html; charset='UTF-8'",
            "Short": "htm"
        },
        "t": {
            "ContentType": "text/plain; charset='UTF-8'",
            "Short": "text"
        },
        "json": {
            "Case": 1,
            "ContentType": "application/json; charset='UTF-8'",
            "Short": "json",
            "challenge": "challenge",
            "logged": "logged",
            "logout": "logout",
            "failed": "falied"
        }
    },
    "Blks": {
        "_gmail": {
            "Transport": "gmail-api",
            "Reply-To": "reply@example.test"
        }
    },
    "Errors": {
        "3001": "Invalid document root or template path.",
        "3002": "Max 20 images only.",
        "3003": "This inventory is either no sold or not existing.",
        "3102": "The password and confirm password does not match please go back and reenter..",
        "3104": "This user name has already been taken."
    },
    "Roles": {
        "adv": {
            "Id_name": "adv_id",
            "Type_id": 4,
            "Attributes": ["adv_id", "a_email", "a_company", "a_contact", "a_timezone_id"],
            "Secret": "replace-adv-secret",
            "Coding": "replace-adv-coding",
            "Surface": "gadv",
            "Duration": 86400,
            "MaxAge": 86400,
	    "Permissions": ["account.security.*", "account.password.change", "api.credential.*", "adv.*", "ac.*", "address.*", "attrname.*", "balance.*", "bidder.propose", "bidder.read", "campaign.*", "chac.*", "creative.*", "item.*", "targetname.*", "report.advertiser.*", "report.marketplace.read", "report.marketplace.export", "report.middleman.read", "report.middleman.export", "quality.evidence.read", "quality.appeal.submit", "payment.read", "payment.funding.bind", "payment.checkout.propose", "payment.operation.execute", "payment.operation.cancel"],
            "Logout": "/",
            "Issuers": {
                "db": {
		    "Default": true,
                    "Screen": 0,
                    "Sql": "SELECT p.adv_id, p.email AS a_email, a.company AS a_company, a.contact AS a_contact, p.timezone_id AS a_timezone_id, p.passwd FROM adv p LEFT JOIN add_address a USING (address_id) WHERE p.email=? AND p.active='Yes'",
                    "Sql_as": "proc_adv_as",
                    "Password_hash": "passwd",
		    "Legacy_password_upgrade": true,
                    "OutPars": [ "adv_id", "a_email", "a_company", "a_contact", "a_timezone_id", "passwd" ],
                    "Credential": [ "email", "passwd", "direct", "gadv" ],
                    "ConditionURI" : [
                        ["uC01","/goto/adv/e/","_md5","/goto/adv/e/campaign?action=topics"],
                        ["uC01","/goto/adv/g/","_md5","/goto/adv/g/campaign?action=topics"]
                    ]
                }
            }
        },
        "pub": {
            "Id_name": "pub_id",
            "Type_id": 3,
            "Attributes": ["pub_id", "p_email", "p_company", "p_contact", "p_timezone_id"],
            "Secret": "replace-pub-secret",
            "Coding": "replace-pub-coding",
            "Surface": "gpub",
            "Duration": 86400,
            "MaxAge": 86400,
	    "Permissions": ["account.security.*", "account.password.change", "pub.*", "ac.*", "address.*", "balance.*", "chac.*", "item.*", "site.*", "slot.*", "weight.*", "supply.propose", "report.publisher.*", "report.marketplace.read", "report.marketplace.export", "quality.evidence.read", "quality.appeal.submit", "payment.read", "payment.payout.bind"],
            "Logout": "/",
            "Issuers": {
                "db": {
		    "Default": true,
                    "Screen": 0,
                    "Sql": "SELECT p.pub_id, p.email AS p_email, a.company AS p_company, a.contact AS p_contact, p.timezone_id AS p_timezone_id, p.passwd FROM pub p LEFT JOIN add_address a USING (address_id) WHERE p.email=? AND p.active='Yes'",
                    "Sql_as": "proc_pub_as",
                    "Password_hash": "passwd",
		    "Legacy_password_upgrade": true,
                    "OutPars": [ "pub_id", "p_email", "p_company", "p_contact", "p_timezone_id", "passwd" ],
                    "Credential": ["email", "passwd", "direct", "gpub"],
                    "ConditionURI" : [
                        ["uC01","/goto/pub/e/","_md5","/goto/pub/e/site?action=topics"],
                        ["uC01","/goto/pub/g/","_md5","/goto/pub/g/site?action=topics"]
                    ]
                }
            }
        },
        "agent": {
            "Id_name": "agent_id",
            "Type_id": 4,
            "Attributes": [ "agent_id", "agent_login", "agent_level" ],
            "Secret": "replace-agent-secret",
            "Coding": "replace-agent-coding",
            "Surface": "gagent",
            "Duration": 86400,
            "MaxAge": 86400,
	    "Permissions": ["account.security.*", "adv.topics", "campaign.topics", "campaign.authen", "item.topics", "item.authen", "advertiser.read", "campaign.review", "creative.review", "quality.evidence.read"],
            "Logout": "/",
            "Issuers": {
                "db": {
                    "Default": true,
                    "Credential": [ "login", "passwd", "direct", "gagent" ],
                    "Sql_as": "SELECT agent_id, login, level FROM agent WHERE login=? AND active='Yes'",
                    "Sql": "SELECT agent_id, login AS agent_login, level AS agent_level, passwd FROM agent WHERE login=? AND active='Yes'",
                    "Password_hash": "passwd",
		    "Legacy_password_upgrade": true,
                    "OutPars": [ "agent_id", "agent_login", "agent_level", "passwd" ]
                }
            }
        },
        "admin": {
            "Id_name": "admin_id",
            "Type_id": 1,
            "Attributes": [ "admin_id", "admin_login" ],
            "Is_admin": true,
            "Secret": "replace-admin-secret",
            "Coding": "replace-admin-coding",
            "Surface": "gadmin",
            "Duration": 86400,
            "MaxAge": 86400,
	    "Permissions": ["*"],
