grant all privileges on singapore.* to 'eightran_goto'@'%';
grant super on *.* to 'eightran_goto'@'%';
grant show_routine on *.* to 'eightran_goto'@'%';
flush privileges;

$ mysql -ueightran_goto -p12pass34 -h vm0 singapore < step0_init.sql
$ go run *go views
$ go run *go channel
$ go run *go geography
$ mysqldump --routines --no-tablespaces -ueightran_goto -p12pass34 -h vm0 singapore  > step4_init.sql

