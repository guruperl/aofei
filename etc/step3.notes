$ mysql -ueightran_goto -p12pass34 -h vm0 aofei < 002.sql
$ mysql -ueightran_goto -p12pass34 -h vm0 aofei < 003.sql
$ mysql -ueightran_goto -p12pass34 -h vm0 aofei < 004.sql
$ go run *go channel
$ go run *go geography
$ mysqldump --routines --no-tablespaces -ueightran_goto -p12pass34 -h vm0 aofei  > step4_init.sql

