# 0) generate two configuration files
$ cp aofei.json ../etc/
$ cp summer.json ../etc/
# and edit them

# 1) create the first demand sample
$ mysql -ueightran_goto -p12pass34 -h vm0 aofei  < demand.sql

# 2) generate default pubmap in database
$ go run *.go pub

# 3) generate executables
go install github.com/genelet/winter/cmd/ledger
go install github.com/genelet/winter/cmd/maxmind
go install github.com/genelet/winter/cmd/nats-client
go install github.com/genelet/winter/cmd/redis-cache
go install github.com/genelet/winter/cmd/unify
go install github.com/genelet/winter/cmd/winloss
go install github.com/genelet/winter/cmd/spread

# 4) generate the maxmind country and region file for parsing 
$ export AOFEI=/srv/aofei/aofei/conf/aofei.json
$ maxmind

# 5) generate the pubmap and demand caches in redis, plus pubmap in conf
$ redis-cache

# 6) spread is nats program to receive caches as local files. It is running as systemd
[Unit]
Description=spread service
After=aofei.service

[Service]
Type=simple
Environment=AOFEI=/srv/aofei/aofei/conf/aofei.json
StandardOutput=append:/srv/aofei/logs/spread.log
StandardError=append:/srv/aofei/logs/spread.log
ExecStart=/srv/aofei/go/bin/spread
Restart=on-failure

[Install]
WantedBy=multi-user.target


# 6) nats-cliet to receive nats logs info the stamped logs. It is running as systemd
# /etc/systemd/system/nats-client.service:
[Unit]
Description=nats-client service
After=aofei.service

[Service]
Type=simple
Environment=AOFEI=/srv/aofei/aofei/conf/aofei.json
StandardOutput=append:/srv/aofei/logs/nats-client.log
StandardError=append:/srv/aofei/logs/nats-client.log
ExecStart=/srv/aofei/aofei/cmd/nats/nats-client -interval=10
Restart=on-failure
#User=peter
#Group=peter

[Install]
WantedBy=multi-user.target

# FYI, nats-server.service 
[Unit]
Description=nats-server service
After=network-online.target
Before=spread.service nats-client.service

[Service]
Type=simple
ExecStart=/srv/aofei/go/bin/nats-server

[Install]
WantedBy=multi-user.target


# 7) run the unify program as systemd web server

[Unit]
Description=Aofei DSP service
After=nats-server.service

[Service]
Type=simple
Environment=SUMMER=/srv/aofei/aofei/conf/summer.json AOFEI=/srv/aofei/aofei/conf/aofei.json
StandardOutput=append:/srv/aofei/logs/unify.log
StandardError=append:/srv/aofei/logs/unify.log
ExecStart=/srv/aofei/aofei/cmd/unify/unify

[Install]
WantedBy=multi-user.target


# 8) edit cronjob to run simulations and 10 minute jobs

# simulate adx request
* * * * * cd /srv/aofei/aofei/etc/samples; curl --data @sample_bid.json --request POST http://x.w8m.com/bid/exchange.example.test; curl --data @sample_bid.json --request POST http://x.w8m.com/bid/exchange.example.test; curl --data @sample_bid.json --request POST http://x.w8m.com/bid/exchange.example.test
# simulate ads reply
* * * * * winloss -bid /bid/exchange.example.test >> /srv/aofei/logs/adx.log 2>&1
# here are the cron jobs to run redis-cache and ledger
5,15,25,35,45,55 * * * * redis-cache -update -interval=10 >> /srv/aofei/logs/redis.cache 2>&1
# run ledger every 10 minutes, here 10 is the same as nats-client in systemd
1,11,21,31,41,51 * * * * ledger -interval=10 >> /srv/aofei/logs/ledger.minutes 2>&1
# run daily kedger
18 0 * * * ledger -daily >> /srv/aofei/logs/ledger.daily 2>&1

