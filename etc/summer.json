{
    "ProjectRoot" : "../pzdesign",
    "Script"       : "/goto",
    "ServerURL"   : "http://localhost:8080",
    "CORSOrigins" : [],
    "ServerPort"  : "8080",
    "DocumentRoot": "../pzdesign/www",
    "UploadURL"   : "http://localhost:8080/uploads",
    "UploadDir"   : ".local/uploads",
    "Template"     : "../pzdesign/tmpls",
    "ConnectArray": ["mysql","aofei:aofei_pass@tcp(127.0.0.1:3307)/aofei?parseTime=true"],
    "Pubrole": "web",
    "Secret": "local-dev-secret",
    "Chartags": {
        "e": {
            "ContentType": "text/html; charset='UTF-8'",
            "Short": "html"
        },
        "g": {
            "ContentType": "text/html; charset='UTF-8'",
            "Short": "htm"
        },
        "t": {
            "ContentType": "text/plain; charset='UTF-8'",
            "Short": "text"
        },
        "json": {
            "Case": 1,
            "ContentType": "application/json; charset='UTF-8'",
            "Short": "json",
            "challenge": "challenge",
            "logged": "logged",
            "logout": "logout",
            "failed": "falied"
        }
    },
    "Blks": {
        "_gmail": {
            "Address": "smtp.example.test:465",
            "Username": "smtp_user",
            "Password": "smtp_pass",
            "From": "service@example.test",
            "Reply_To": "reply@example.test"
        }
    },
    "Errors": {
        "3001": "Invalid document root or template path.",
        "3002": "Max 20 images only.",
        "3003": "This inventory is either no sold or not existing.",
        "3102": "The password and confirm password does not match please go back and reenter..",
        "3104": "This user name has already been taken."
    },
    "Roles": {
        "adv": {
            "Id_name": "adv_id",
            "Type_id": 4,
            "Attributes": ["adv_id", "a_email", "a_company", "a_contact", "a_timezone_id"],
            "Secret": "adv-local-secret",
            "Coding": "adv-local-coding",
            "Surface": "gadv",
            "Duration": 86400,
            "MaxAge": 86400,
            "Logout": "/",
            "Issuers": {
                "db": {
		    "Default": true,
                    "Screen": 1,
                    "Sql": "proc_adv",
                    "Sql_as": "proc_adv_as",
                    "Credential": [ "email", "passwd", "direct", "gadv" ],
                    "ConditionURI" : [
                        ["uC01","/goto/adv/e/","_md5","/goto/adv/e/campaign?action=topics"],
                        ["uC01","/goto/adv/g/","_md5","/goto/adv/g/campaign?action=topics"]
                    ]
                }
            }
        },
        "pub": {
            "Id_name": "pub_id",
            "Type_id": 3,
            "Attributes": ["pub_id", "p_email", "p_company", "p_contact", "p_timezone_id"],
            "Secret": "pub-local-secret",
            "Coding": "pub-local-coding",
            "Surface": "gpub",
            "Duration": 86400,
            "MaxAge": 86400,
            "Logout": "/",
            "Issuers": {
                "db": {
		    "Default": true,
                    "Screen": 1,
                    "Sql": "proc_pub",
                    "Sql_as": "proc_pub_as",
                    "Credential": ["email", "passwd", "direct", "gpub"],
                    "ConditionURI" : [
                        ["uC01","/goto/pub/e/","_md5","/goto/pub/e/site?action=topics"],
                        ["uC01","/goto/pub/g/","_md5","/goto/pub/g/site?action=topics"]
                    ]
                }
            }
        },
        "agent": {
            "Id_name": "agent_id",
            "Type_id": 4,
            "Attributes": [ "agent_id", "agent_login", "agent_level" ],
            "Secret": "agent-local-secret",
            "Coding": "agent-local-coding",
            "Surface": "gagent",
            "Duration": 86400,
            "MaxAge": 86400,
            "Logout": "/",
            "Issuers": {
                "db": {
                    "Default": true,
                    "Credential": [ "login", "passwd", "direct", "gagent" ],
                    "Sql_as": "SELECT agent_id, login, level FROM agent WHERE login=? AND active='Yes'",
                    "Sql": "SELECT agent_id, login, level FROM agent WHERE login=? AND passwd=SHA1(CONCAT(?,login)) AND active='Yes'"
                }
            }
        },
        "admin": {
            "Id_name": "admin_id",
            "Type_id": 1,
            "Attributes": [ "admin_id", "admin_login" ],
            "Is_admin": true,
            "Secret": "admin-local-secret",
            "Coding": "admin-local-coding",
            "Surface": "gadmin",
            "Duration": 86400,
            "MaxAge": 86400,
            "Logout": "/",
            "Issuers": {
                "db": {
		"Default": true,
                    "Credential": [ "login", "passwd", "direct", "gadmin" ],
                    "Sql": "SELECT admin_id, login FROM admin WHERE login=? AND passwd=SHA1(CONCAT(?,login)) AND active='Yes'"
                }
            }
        }
    }
}
