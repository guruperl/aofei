<input type=hidden name=campaignmd5 value='[% campaignmd5 %]'>
<input type=hidden name=campaignname value='[% campaignname %]'>
<table id=companytable>
<tr><th>Domain</th><th><img src="/uilib/comImg/delete.gif" id="companydelete"><th></tr>
[% FOREACH item IN company %]<tr>
<td>[% item.6 %]</td>
<td><input type=radio name=companyvalueid value="[% item.3 %]" /></td>
</tr>[% END %]
</table>
<input type=text name=name size=15 />
<input type=button id=companysubmit value="添加">
</form>

