
<h2>操作系统投放</h2>
<form name=os method=post action=targetname>
<input type=hidden name=action value='myinsert'>
<input type=hidden name=attrnameid value='6'>[% IF os %]
<input type=hidden name=targetnameid value='[% os.0.1 %]'>[% END %]
<input type=hidden name=entitytype value='[% entitytype %]'>
<input type=hidden name=itemid value='[% itemid %]'>
<input type=hidden name=itemmd5 value='[% itemmd5 %]'>
<input type=hidden name=itemname value='[% itemname %]'>
<input type=hidden name=campaignid value='[% campaignid %]'>
<input type=hidden name=campaignmd5 value='[% campaignmd5 %]'>
<input type=hidden name=campaignname value='[% campaignname %]'>
<select id='osselect' name=valueid multiple">
[% FOREACH item IN OSES %]<option [% IFED('selected', item.osid, os, 3) %] value="[% item.osid %]">[% item.name %]</option>
[% END %]</select>
<p><p>
<input type=button id=ossubmit value="更新">
<input type="text" id="os" style="border:0; color:#f6931f; font-weight:bold;" />
<ul id="osselect_selectedItems">
</ul>
</form>

<p> &nbsp; </p>

