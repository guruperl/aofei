[% SET us=0 %][% FOREACH c IN country %][% IF (c.3 == 233) %][% SET us=1 %][% END %][% END %][% IF us %]

<h2>按照邮政编码</h2>
<form name=zip method=post action=targetname>
<input type=hidden name=action value='myinsert'>
<input type=hidden name=attrnameid value='11'>[% IF zip %]
<input type=hidden name=targetnameid value='[% zip.0.1 %]'>[% END %]
<input type=hidden name=entitytype value='[% entitytype %]'>
<input type=hidden name=itemid value='[% itemid %]'>
<input type=hidden name=itemmd5 value='[% itemmd5 %]'>
<input type=hidden name=itemname value='[% itemname %]'>
<input type=hidden name=campaignid value='[% campaignid %]'>
<input type=hidden name=campaignmd5 value='[% campaignmd5 %]'>
<input type=hidden name=campaignname value='[% campaignname %]'>
<table id=ziptable>
<tr><th>邮编</th><th><img src="/uilib/comImg/delete.gif" id="zipdelete"><th></tr>
[% FOREACH item IN zip %]<tr>
<td>[% item.3 %]</td>
<td><input type=radio name=zipvalueid value="[% item.3 %]" /></td>
</tr>[% END %]
</table>
<input type=text name=valueid size=6 />
<input id="zipsubmit" type=button value="添加">
</form>

<p> &nbsp; </p>

