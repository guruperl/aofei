<input type=hidden name=action value='myinsert'>
<input type=hidden name=attrnameid value='13'>[% IF dma %]
<input type=hidden name=targetnameid value='[% dma.0.1 %]'>[% END %]
<input type=hidden name=entitytype value='[% entitytype %]'>
<input type=hidden name=itemid value='[% itemid %]'>
<input type=hidden name=itemmd5 value='[% itemmd5 %]'>
<input type=hidden name=itemname value='[% itemname %]'>
<input type=hidden name=campaignid value='[% campaignid %]'>
<input type=hidden name=campaignmd5 value='[% campaignmd5 %]'>
<input type=hidden name=campaignname value='[% campaignname %]'>
<select id='dmaselect' name=valueid multiple">
[% FOREACH item IN DMAS %]<option [% IFED('selected', item.metrocode, dma, 3) %] value="[% item.metrocode %]">[% item.metrocode %] - [% item.description %]</option>
[% END %]</select>
<p><p>
<input type=button id=dmasubmit value="更新">
<input type="text" id="dma" style="border:0; color:#f6931f; font-weight:bold;" />
<ul id="dmaselect_selectedItems">
</ul>
</form>


