[% IF (entitytype=='item') %]
<input type="button" onclick="if(confirm('Do you want to use your campaign targeting? This will remove existing records that you had added!')){window.location='targetname?action=updateorder&entitytype=item&target=Inherit&itemid=[% itemid %]&itemmd5=[% itemmd5 %]&itemname_esc=[% itemname_esc %]&campaignid=[% campaignid %]&campaignmd5=[% campaignmd5 %]&campaignname_esc=[% campaignname_esc %]'}" value="Inherit From Campaign" />
<p></p>[% END %]

<h2>Country Targeting</h2>
<form name=country method=post action=targetname>
<input type=hidden name=action value='myinsert'>
<input type=hidden name=attrnameid value='8'>[% IF country %]
<input type=hidden name=targetnameid value='[% country.0.1 %]'>[% END %]
<input type=hidden name=entitytype value='[% entitytype %]'>
<input type=hidden name=itemid value='[% itemid %]'>
<input type=hidden name=itemmd5 value='[% itemmd5 %]'>
<input type=hidden name=itemname value='[% itemname %]'>
<input type=hidden name=campaignid value='[% campaignid %]'>
<input type=hidden name=campaignmd5 value='[% campaignmd5 %]'>
<input type=hidden name=campaignname value='[% campaignname %]'>
<select id='countryselect' name=valueid multiple>
[% FOREACH item IN COUNTRIES %]<option [% IFED('selected', item.countryid, country, 3) %] value="[% item.countryid %]">[% item.name %]</option>
[% END %]</select>
<p><p>
<input type=button id=countrysubmit value="Update">
<input type="text" id="country" style="border:0; color:#f6931f; font-weight:bold;" />
<ul id="countryselect_selectedItems">
</ul>
</form>

<p> &nbsp; </p>

<h2>Region Targeting</h2>
<form name=state method=post action=targetname>
<input type=hidden name=action value='myinsert'>
<input type=hidden name=attrnameid value='9'>[% IF state %]
<input type=hidden name=targetnameid value='[% state.0.1 %]'>[% END %]
<input type=hidden name=entitytype value='[% entitytype %]'>
<input type=hidden name=itemid value='[% itemid %]'>
<input type=hidden name=itemmd5 value='[% itemmd5 %]'>
<input type=hidden name=itemname value='[% itemname %]'>
<input type=hidden name=campaignid value='[% campaignid %]'>
<input type=hidden name=campaignmd5 value='[% campaignmd5 %]'>
<input type=hidden name=campaignname value='[% campaignname %]'>
<select id='stateselect' name=valueid multiple>
[% FOREACH c IN country %][% SET key=c.3 %][% SET S=STATES.$key %][% SET substate=SUBUNITS(state, S) %]
[% FOREACH item IN S %]<option [% IFED('selected', item.0, substate, 3) %] value="[% item.0 %]">[% item.1 %]</option>
[% END %][% END %]</select>
<p><p>
<input type=button id=statesubmit value="Update">
<input type="text" id="state" style="border:0; color:#f6931f; font-weight:bold;" />
<ul id="stateselect_selectedItems">
</ul>
</form>

<p> &nbsp; </p>

[% SET found=0 %][% FOREACH s IN state %][% IF s.3 < 100 %][% found=1 %][% END %][% END %][% IF found %]
<h2>City Targeting</h2>
<form name=city method=post action=targetname>
<input type=hidden name=action value='myinsert'>
<input type=hidden name=attrnameid value='10'>[% IF city %]
<input type=hidden name=targetnameid value='[% city.0.1 %]'>[% END %]
<input type=hidden name=entitytype value='[% entitytype %]'>
<input type=hidden name=itemid value='[% itemid %]'>
<input type=hidden name=itemmd5 value='[% itemmd5 %]'>
<input type=hidden name=itemname value='[% itemname %]'>
<input type=hidden name=campaignid value='[% campaignid %]'>
<input type=hidden name=campaignmd5 value='[% campaignmd5 %]'>
<input type=hidden name=campaignname value='[% campaignname %]'>
<select id='cityselect' name=valueid multiple></select>
<p><p>
<input type=button id=citysubmit value="Update">
<input type="text" id="city" style="border:0; color:#f6931f; font-weight:bold;" />
<script type="text/javascript">
var CITIES = new Array();
var cityids = [ [% SELECTED(city, 3) %] ];
var stateids = new Array();[% FOREACH s IN state %][% IF s.3 < 100 %]
stateids.push([% s.3 %]);[% END %][% END %]
var cityselect = $('#cityselect');
var cityoptions = cityselect.attr('options');
$('option', cityselect).remove();
</script>[% FOREACH s IN state %][% IF s.3 < 100 %]
<script type="text/javascript" src="/cache/cities/[% s.3 %]_js.js"></script>[% END %][% END %]
<script type="text/javascript">
for (var k=0; k<stateids.length; k++) {
  for (var i=0; i<CITIES[stateids[k]].length; i++) {
    var selected = false;
    for (var j=0; j<cityids.length; j++)
      if (cityids[j] == CITIES[stateids[k]][i][0]) selected = true;
    cityselect.append(new Option(CITIES[stateids[k]][i][1], CITIES[stateids[k]][i][0], false, selected));
  }
}
</script>
<ul id="cityselect_selectedItems">
</ul>
</form>
[% END %]
