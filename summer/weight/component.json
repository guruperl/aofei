{
  "actions" : {
    "startnew" : {"groups":["pub"],"validate":["slot_id"]},
    "startnewFast" : {"groups":["pub"],"validate":["slot_id"]},
    "insert"   : {"validate":["slot_id"]},
    "topics"   : {},
    "update"   : {"validate":["weight_id"]},
    "edit"     : {"validate":["weight_id"]},
    "delete"   : {"validate":["weight_id"]}
  },
  "fks" : {
    "pub" : ["slot_id", "slot_md5"]
  },

  "insert_pars":[            "slot_id","item_id","weight","created"],
  "update_pars":["weight_id","slot_id","item_id","weight"],
  "edit_pars"  :["weight_id","slot_id","item_id","weight","created"],

  "current_table"  :"pub_weight",
  "current_key"    :"weight_id",
  "current_id_auto":"weight_id",

  "current_tables":[
    {"name":"pub_weight", "alias":"w"},
    {"name":"adv_item", "alias":"i", "type":"INNER", "using":"item_id"},
    {"name":"adv_creative", "alias":"v", "type":"INNER", "using":"item_id"},
    {"name":"adv_campaign", "alias":"c", "type":"INNER", "using":"campaign_id"}
  ],

  "topics_hash":{
    "w.weight_id":"weight_id",
    "w.item_id":"item_id",
    "w.weight":"weight",
    "w.slot_id":"slot_id",
    "v.size_id":"size_id",
    "CASE i.cost_type WHEN 'ROI' THEN 4 WHEN 'CPA' THEN 3 WHEN 'CPC' THEN 2 ELSE 1 END": "cost_type",
    "i.cost":"price",
    "UNIX_TIMESTAMP(i.endx)":"endx",
    "i.qa_mime+0":"mime8",
    "c.campaign_id":"campaign_id",
    "i.qa_item":"qa_item",
    "i.cpm_fc":"cpm_fc",
    "i.cpm_length":"cpm_length",
    "i.cpm_throttle":"cpm_throttle",
    "i.cpc_fc":"cpc_fc",
    "i.cpc_length":"cpc_length"
  }
}
