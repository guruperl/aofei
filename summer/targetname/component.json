{
  "actions" : {
    "topics" :{"groups":["adv"],"validate":["campaign_id"]},
    "insert" :{"groups":["adv"],"validate":["campaign_id"]},
    "delete" :{"groups":["adv"],"validate":["campaign_id"]}
  },

  "fks" : {
    "adv" : ["campaign_id", "campaign_md5", "targetname_id", "targetname_md5"]
  },

  "nextpages" : {
    "topics" : [
      {"model":"targetname", "action":"topicsCustom"},
      {"model":"targetname", "action":"topicsCities"},
      {"model":"targetname", "action":"topicsStates"},
      {"model":"targetname", "action":"topicsDmas"},
      {"model":"targetname", "action":"topicsIsps"}
    ]
  },

  "topics_pars":["targetname_id","campaign_id","attrname_id"],

  "current_table"  :"adv_targetname",
  "current_key"    :"targetname_id",
  "current_id_auto":"targetname_id",

  "current_tables" : [
    {"name":"adv_targetname", "alias":"tn"},
    {"name":"adv_targetvalue", "alias":"tv", "type":"INNER", "using":"targetname_id"},
    {"name":"adv_attrname", "alias":"an", "type":"INNER", "using":"attrname_id"},
    {"name":"adv_attrvalue", "alias":"av", "type":"LEFT", "ON":"an.attrname_id=av.attrname_id AND tv.value_id=av.attrvalue_id"}
  ],
  "topics_hash" : {
    "tn.targetname_id":"targetname_id",
	"tv.targetvalue_id":"targetvalue_id",
	"tv.value_id":"value_id",
	"an.attrname_id":"attrname_id",
	"an.attrname":"attrname",
	"av.attrvalue_id":"attrvalue_id"
  }
}
